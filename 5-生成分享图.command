#!/bin/bash
# ============================================================
#  生成分享图 —— 双击运行
#
#  作用：给每个页面做一张 1200×630 的分享图（og:image）。
#        有了它，把网址发到微信 / 群里时卡片上就有图，
#        不然只有一行灰字。
#
#  产物：og/<页面名>.png，例如 og/apps.png
#  何时要跑：加了新页面、或者想改分享图上的文案时。
#           平时不用管 —— 图是静态文件，编一次一直在。
#
#  依赖：本机装了 Chrome（或 Edge / Chromium）。不装也不影响网站，
#        build.py 找不到图会自动用 og/default.png 顶上。
# ============================================================

cd "$(dirname "$0")" || exit 1

G='\033[32m'; R='\033[31m'; Y='\033[33m'; D='\033[2m'; N='\033[0m'
PY="$(command -v python3 || echo /usr/bin/python3)"

echo ""
echo "  =================================================="
echo "   生成全站分享图（og:image）"
echo "  =================================================="
echo ""

"$PY" 生成分享图.py
code=$?

echo ""
if [ $code -eq 0 ]; then
  echo -e "  ${G}✓ 完成${N}  图片在 og/ 目录里"
  echo -e "  ${D}  想让网站用上新图：双击「2-更新网站.command」上线${N}"
else
  echo -e "  ${R}✗ 没成功${N}  上面有原因，把报错发我看看"
fi
echo ""
echo -e "  ${D}按回车关闭这个窗口${N}"
read -r _
